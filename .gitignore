# datasets and resample indices (12 GB) - see README section 2.
# Only the empty folder structure is kept (data/ts, data/indices) via .gitkeep files.
data/*
!data/ts/
!data/indices/
data/ts/*
data/indices/*
!data/ts/.gitkeep
!data/indices/.gitkeep

# results of experiments that are not part of the report (kept locally only)
results_dropped/

# the selection log of a full run (142 datasets x 30 resamples) is about 200 MB, over GitHub's file limit
results/*ucr142*_selection.csv

# the per-run test labels and class probabilities of --save_predictions (1,420 small files; notebook 05, section 8c
# reads them; the command in experiments.md writes them again)
results/*_predictions/

# environment and caches
.venv/
.venv-gpu/
__pycache__/
.ipynb_checkpoints/

# editor settings
.vscode/
